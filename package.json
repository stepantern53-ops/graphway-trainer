{
  "name": "graphway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "tsx apps/server/src/cli/migrate.ts",
    "db:migrate:production": "node apps/server/dist/cli/migrate.js --production",
    "db:test:prepare": "node scripts/local-db.mjs test:prepare",
    "admin:provision": "tsx apps/server/src/cli/provision-admin.ts",
    "admin:provision:production": "node apps/server/dist/cli/provision-admin.js --production",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint packages apps scripts --max-warnings=0",
    "test:unit": "node scripts/test-unit.mjs",
    "test:integration": "vitest run --project server --no-file-parallelism --maxWorkers=1",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/server/dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/manrope": "^5.2.6",
    "@playwright/test": "^1.56.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.181.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.3.0",
    "katex": "^0.19.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "zod": "^4.1.12"
  }
}
